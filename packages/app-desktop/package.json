{
  "name": "@sovit/app-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "pear-electron shell: Bare worker hosting seeder + blob server, preload bridge exposing NetworkAdapter only",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src",
    "bundle": "node scripts/bundle.ts",
    "start": "npm run bundle && electron dist/main/main.js --dev-mocks --dev-fixtures",
    "test:e2e": "NUTFLIX_E2E=1 node --test --test-concurrency=1 e2e/fidelity.e2e.ts e2e/stage1.e2e.ts e2e/signer.e2e.ts e2e/proxy-abort.e2e.ts e2e/nfx-playback.e2e.ts",
    "stage": "node packaging/cli.ts stage",
    "package": "node packaging/cli.ts package",
    "make": "node packaging/cli.ts make"
  },
  "dependencies": {
    "@sovit/core": "0.0.0",
    "@sovit/gateway": "0.0.0",
    "@sovit/seeder": "0.0.0",
    "@sovit/ui": "0.0.0",
    "bare-encoding": "1.0.3",
    "bare-fs": "4.8.1",
    "bare-hrtime": "2.1.2",
    "bare-http1": "4.6.1",
    "bare-os": "3.9.3",
    "bare-path": "3.1.2",
    "bare-sidecar": "0.5.4",
    "bare-subprocess": "6.1.0",
    "corestore": "7.12.2",
    "hyperblobs": "2.12.1",
    "hypercore": "11.35.3",
    "hypercore-blob-server": "1.15.0",
    "hyperswarm": "4.17.0",
    "pear-runtime": "1.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sodium-native": "5.1.0"
  },
  "devDependencies": {
    "@electron-forge/core": "8.0.0-alpha.10",
    "@electron-forge/maker-base": "8.0.0-alpha.10",
    "@electron-forge/maker-deb": "8.0.0-alpha.10",
    "@electron-forge/maker-squirrel": "8.0.0-alpha.10",
    "@electron-forge/shared-types": "8.0.0-alpha.10",
    "@electron/asar": "4.3.0",
    "@electron/fuses": "2.1.3",
    "@scure/bip39": "2.0.1",
    "electron": "44.9.3",
    "esbuild": "0.28.2",
    "hyperdht": "6.34.0",
    "jsdom": "29.1.1",
    "playwright-core": "1.63.0"
  }
}
