{
  "name": "@sovit/ui",
  "version": "0.0.0",
  "private": true,
  "description": "React design system, screens, player. Talks only to NetworkAdapter.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui.css": "./dist/ui.css",
    "./tokens.css": "./dist/tokens.css",
    "./components.css": "./dist/components.css",
    "./screens.css": "./dist/screens.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/build-css.ts",
    "build:tokens": "tsc -b && node scripts/build-tokens.ts",
    "build:css": "node scripts/build-css.ts",
    "test": "vitest run",
    "lint": "eslint src",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build -o storybook-static --quiet",
    "screenshots": "node scripts/screenshots.ts"
  },
  "dependencies": {
    "@sovit/core": "0.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "29.1.1",
    "playwright-core": "1.63.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "vite": "8.2.4"
  }
}
