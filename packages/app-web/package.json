{
  "name": "@sovit/app-web",
  "version": "0.0.0",
  "private": true,
  "description": "Web client for NFX videos (ADR 0022): the @sovit/ui screens, NFX over ordinary Nostr relays, video over WebRTC",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:site": "node scripts/build-site.ts",
    "nfx-lib": "bash scripts/nfx-lib.sh",
    "test": "vitest run",
    "test:e2e": "node e2e/web.e2e.ts",
    "lint": "eslint src site scripts e2e"
  },
  "dependencies": {
    "@sovit/core": "0.0.0",
    "@sovit/ui": "0.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "playwright-core": "1.63.0"
  }
}
