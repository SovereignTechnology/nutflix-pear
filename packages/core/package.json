{
  "name": "@sovit/core",
  "version": "0.0.0",
  "private": true,
  "description": "Runtime-agnostic protocol library: contracts, manifest, nostr data layer, payment, signer, wallet, pay/1",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./media/node": {
      "types": "./dist/media/node/index.d.ts",
      "default": "./dist/media/node/index.js"
    },
    "./nostr": {
      "types": "./dist/nostr/index.d.ts",
      "default": "./dist/nostr/index.js"
    },
    "./nfx": {
      "types": "./dist/nfx/index.d.ts",
      "default": "./dist/nfx/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "devDependencies": {
    "fast-check": "4.9.0"
  },
  "dependencies": {
    "@cashu/cashu-ts": "4.10.0",
    "@scure/bip39": "2.0.1",
    "compact-encoding": "3.4.0",
    "nostr-tools": "2.25.2",
    "sodium-universal": "5.0.1"
  }
}
