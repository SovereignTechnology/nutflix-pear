{
  "name": "nutflix-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Nutflix: peer-to-peer video where seeders are paid per block in Cashu ecash. Nostr discovery, Hypercore transport, Electron desktop app.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SovereignTechnology/nutflix-pear.git"
  },
  "bugs": {
    "url": "https://github.com/SovereignTechnology/nutflix-pear/issues"
  },
  "homepage": "https://github.com/SovereignTechnology/nutflix-pear#readme",
  "author": "Sovereign Technology",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run -w packages/ui build:css && npm run -w packages/app-desktop bundle",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check:locked": "bash scripts/check-locked-dirs.sh",
    "check:contracts": "bash scripts/check-contracts-version.sh",
    "hooks:install": "bash scripts/install-hooks.sh",
    "check:native": "bash scripts/native-module-inventory.sh --check",
    "lint:electron": "node scripts/electron-security-lint.mjs packages/app-desktop",
    "build:web:reproducible": "bash scripts/reproducible-web-build.sh",
    "ci": "npm run lint && npm run build && npm test && npm run check:locked && npm run check:native && npm run lint:electron"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "eslint": "10.10.0",
    "nostr-tools": "2.25.2",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.5",
    "ws": "8.21.3"
  }
}
